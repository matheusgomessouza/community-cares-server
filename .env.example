# Runtime
NODE_ENV=local
PORT=8088

# Authentication
AUTH_SECRET_KEY=
REFRESH_SECRET_KEY=

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID_WEB_DEV=
GITHUB_CLIENT_SECRET_WEB_DEV=
GITHUB_CLIENT_ID_WEB_PRD=
GITHUB_CLIENT_SECRET_WEB_PRD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# SMTP transport for the reset email. Leave SMTP_HOST unset to write the reset
# link to the server console in development. Production requires SMTP_HOST and
# SMTP_FROM. Set SMTP_USER and SMTP_PASS together when the server needs
# authentication.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Community Cares <no-reply@example.com>"
