# Runtime
NODE_ENV=local
PORT=8088

# Authentication
AUTH_SECRET_KEY=
REFRESH_SECRET_KEY=

# Database
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID_WEB_DEV=
GITHUB_CLIENT_SECRET_WEB_DEV=
GITHUB_CLIENT_ID_WEB_PRD=
GITHUB_CLIENT_SECRET_WEB_PRD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3000

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# The mail transport is not configured yet. In development the reset link is
# written to the server console.
